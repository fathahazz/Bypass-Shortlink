# API Bypass Eksternal (Primary Resolver)
# Jika tidak diisi, sistem akan otomatis fallback ke native resolver
BYPASS_API_URL=https://api.example-bypass.com/v1/resolve
BYPASS_API_KEY=your_external_api_key_here

# Upstash Redis untuk Rate Limiting (10 req/menit per IP) & Health Metrics
# Jika tidak diisi, sistem otomatis fallback ke in-memory storage
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
